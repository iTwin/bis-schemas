  <ECEntityClass typeName="FrequencyConverterPhysicalCustomAspect" displayLabel="Frequency Converter Custom Aspect" description="A device to convert from one frequency to another (e.g., frequency F1 to F2) comprises a pair of FrequencyConverter instances. One converts from F1 to DC, the other converts the DC to F2." modifier="None">
