  </ECEntityClass>
  <ECEntityClass typeName="PotentialTransformerPhysicalCustomAspect" displayLabel="Potential Transformer Physical Custom Aspect" description="AuxiliaryEquipment describe equipment that is not performing any primary functions but support for the equipment performing the primary function.&#x000d; AuxiliaryEquipment is attached to primary equipment via an association with Terminal." modifier="None">
