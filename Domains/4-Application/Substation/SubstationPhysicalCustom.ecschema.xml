  <ECEntityClass typeName="ConnectorPhysicalCustomAspect" displayLabel="Connector Custom Aspect" description="A conductor, or group of conductors, with negligible impedance, that serve to connect other conducting equipment within a single substation and are modelled with a single logical terminal." modifier="None">
