  </ECEntityClass>
  <ECEntityClass typeName="GroundingImpedancePhysicalCustomAspect" displayLabel="Grounding Impedance Custom Aspect" description="A fixed impedance device used for grounding.&#x000d; " modifier="None">
    <BaseClass>EarthFaultCompensatorPhysicalCustomAspect</BaseClass>
  </ECEntityClass>
  <ECEntityClass typeName="PetersenCoilPhysicalCustomAspect" displayLabel="Petersen Coil Custom Aspect" description="A variable impedance device normally used to offset line charging during single line faults in an ungrounded section of network." modifier="None">
