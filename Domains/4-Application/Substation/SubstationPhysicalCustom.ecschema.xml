  <ECEntityClass typeName="CompensatorPhysicalCustomAspect" displayLabel="Compensator Custom Aspect" description="A Series Compensator is a series capacitor or reactor or an AC transmission line without charging susceptance.  It is a two terminal device." modifier="None">
    <BaseClass>EquipmentPhysicalCustomAspect</BaseClass>
  </ECEntityClass>
  <ECEntityClass typeName="SeriesCompensatorPhysicalCustomAspect" displayLabel="Series Compensator Custom Aspect" description="A Series Compensator is a series capacitor or reactor or an AC transmission line without charging susceptance.  It is a two terminal device." modifier="None">
