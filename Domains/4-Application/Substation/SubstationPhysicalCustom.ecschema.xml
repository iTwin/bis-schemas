  </ECEntityClass>
  <ECEntityClass typeName="SensorPhysicalCustomAspect" displayLabel="Sensor Custom Aspect" description="AuxiliaryEquipment describes equipment that does not perform primary functions but supports equipment that does." modifier="None">
    <BaseClass>AuxiliaryEquipmentPhysicalCustomAspect</BaseClass>
  </ECEntityClass>
  <ECEntityClass typeName="EarthFaultCompensatorPhysicalCustomAspect" displayLabel="Earth Fault Compensator Custom Aspect" description="A conducting equipment used to represent a connection to ground which is typically used to compensate earth faults. An earth fault compensator device modelled with a single terminal implies a second terminal solidly connected to ground. If two terminals are modelled, the ground is not assumed and normal connection rules apply.&#x000d; " modifier="None">
    <BaseClass>EquipmentPhysicalCustomAspect</BaseClass>
  </ECEntityClass>
  <ECEntityClass typeName="DisconnectingCircuitBreakerPhysicalCustomAspect" displayLabel="Circuit Breaker With Disconnector Custom Aspect" description="A circuit breaking device including disconnecting function, eliminating the need for separate disconnectors." modifier="None">
    <BaseClass>BreakerPhysicalCustomAspect</BaseClass>
  </ECEntityClass>
  <ECEntityClass typeName="PotentialTransformerPhysicalCustomAspect" displayLabel="Potential Transformer Custom Aspect" description="AuxiliaryEquipment describe equipment that is not performing any primary functions but support for the equipment performing the primary function.&#x000d; AuxiliaryEquipment is attached to primary equipment via an association with Terminal." modifier="None">
