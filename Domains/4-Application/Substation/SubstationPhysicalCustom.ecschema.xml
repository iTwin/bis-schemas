  <ECEntityClass typeName="TransformerPhysicalCustomAspect" displayLabel="Transformer Physical Custom Aspect" description="Power transformers are utilized in transmission networks with significantly higher voltage, while distribution transformers function in distribution networks defined by lower voltages" modifier="None">
