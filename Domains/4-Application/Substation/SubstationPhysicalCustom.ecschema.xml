  <ECEntityClass typeName="CompensatorPhysicalCustomAspect" displayLabel="Compensator Physical Custom Aspect" description="A Series Compensator is a series capacitor or reactor or an AC transmission line without charging susceptance.  It is a two terminal device." modifier="None">
