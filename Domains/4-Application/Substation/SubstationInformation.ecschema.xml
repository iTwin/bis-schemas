<ECSchema xmlns="http://www.bentley.com/schemas/Bentley.ECXML.3.2" schemaName="SubstationInformation" version="01.00.06" alias="subinf" displayLabel="SubstationInformation" description="This schema contains classes used for Substation Design.">
  <ECSchemaReference name="BisCore" version="01.00.25" alias="bis"/>
  <ECSchemaReference name="CoreCustomAttributes" version="01.00.04" alias="CoreCA" />
  <ECSchemaReference name="BisCustomAttributes" version="01.00.00" alias="bisCA" />
  <ECCustomAttributes>
    <ProductionStatus xmlns="CoreCustomAttributes.01.00.04">
      <SupportedUse>NotForProduction</SupportedUse>
    </ProductionStatus>
    <SchemaLayerInfo xmlns="BisCustomAttributes.01.00.00">
      <Value>Application</Value>
    </SchemaLayerInfo>
  </ECCustomAttributes>
  <!-- Enumerations -->
  <ECEnumeration typeName="SymbolType" name="SymbolType" backingTypeName="int" isStrict="true" displayLabel="Symbol Type">
    <ECEnumerator value="0" name="Schematic" displayLabel="Schematic"/>
    <ECEnumerator value="1" name="Panel" displayLabel="Panel"/>
    <ECEnumerator value="2" name="SingleLine" displayLabel="Single Line"/>
    <ECEnumerator value="3" name="Physical3D" displayLabel="3D"/>
    <ECEnumerator value="4" name="WireDiagram" displayLabel="Wire Diagram"/>
    <ECEnumerator value="5" name="Hydraulic" displayLabel="Hydraulic"/>
    <ECEnumerator value="6" name="Pneumatic" displayLabel="Pneumatic"/>
  </ECEnumeration>
  <ECEnumeration typeName="StrutChannelProfile" backingTypeName="int" isStrict="true" displayLabel="Strut Channel Profile" description="The cross-section configuration of a strut channel.">
    <ECEnumerator value="0" name="Single" displayLabel="Single"/>
    <ECEnumerator value="1" name="BackToBack" displayLabel="Back-to-Back"/>
    <ECEnumerator value="2" name="DoubleSideBySide" displayLabel="Double Side-by-Side"/>
  </ECEnumeration>
  <ECEnumeration typeName="StrutChannelHolePattern" backingTypeName="int" isStrict="true" displayLabel="Strut Channel Hole Pattern" description="The pattern of holes or slots punched along the back of a strut channel.">
    <ECEnumerator value="0" name="Solid" displayLabel="Solid"/>
    <ECEnumerator value="1" name="Slotted" displayLabel="Slotted"/>
    <ECEnumerator value="2" name="LongSlotted" displayLabel="Long Slotted"/>
    <ECEnumerator value="3" name="RoundHoles" displayLabel="Round Holes"/>
    <ECEnumerator value="4" name="Knockout" displayLabel="Knockout"/>
  </ECEnumeration>
  <ECEnumeration typeName="StrutChannelMaterial" backingTypeName="int" isStrict="true" displayLabel="Strut Channel Material" description="The base material a strut channel is manufactured from.">
    <ECEnumerator value="0" name="CarbonSteel" displayLabel="Carbon Steel"/>
    <ECEnumerator value="1" name="StainlessSteel" displayLabel="Stainless Steel"/>
    <ECEnumerator value="2" name="Aluminum" displayLabel="Aluminum"/>
    <ECEnumerator value="3" name="Fiberglass" displayLabel="Fiberglass"/>
  </ECEnumeration>
  <ECEnumeration typeName="StrutChannelSurfaceFinish" backingTypeName="int" isStrict="true" displayLabel="Strut Channel Surface Finish" description="The protective surface finish applied to a strut channel.">
    <ECEnumerator value="0" name="PreGalvanized" displayLabel="Pre-Galvanized"/>
    <ECEnumerator value="1" name="HotDipGalvanized" displayLabel="Hot-Dip Galvanized"/>
    <ECEnumerator value="2" name="Painted" displayLabel="Painted"/>
    <ECEnumerator value="3" name="Plain" displayLabel="Plain"/>
  </ECEnumeration>
  <ECEnumeration typeName="StrutChannelMountingOrientation" backingTypeName="int" isStrict="true" displayLabel="Strut Channel Mounting Orientation" description="The direction the open face of a strut channel points when installed.">
    <ECEnumerator value="0" name="OpeningUp" displayLabel="Opening Up"/>
    <ECEnumerator value="1" name="OpeningDown" displayLabel="Opening Down"/>
    <ECEnumerator value="2" name="OpeningLeft" displayLabel="Opening Left"/>
    <ECEnumerator value="3" name="OpeningRight" displayLabel="Opening Right"/>
  </ECEnumeration>
  <ECEnumeration typeName="StrutChannelSupportApplication" backingTypeName="int" isStrict="true" displayLabel="Strut Channel Support Application" description="The primary support application a strut channel is used for.">
    <ECEnumerator value="0" name="ConduitSupport" displayLabel="Conduit Support"/>
    <ECEnumerator value="1" name="CableTraySupport" displayLabel="Cable Tray Support"/>
    <ECEnumerator value="2" name="EquipmentMounting" displayLabel="Equipment Mounting"/>
    <ECEnumerator value="3" name="GeneralFraming" displayLabel="General Framing"/>
  </ECEnumeration>
  <ECEnumeration typeName="CableMaterial" backingTypeName="int" isStrict="false" displayLabel="Cable Material" description="The conductor material construction of a cable.">
    <ECEnumerator value="0" name="AAC" displayLabel="AAC (All Aluminum Conductor)"/>
    <ECEnumerator value="1" name="AAAC" displayLabel="AAAC (All Aluminum Alloy Conductor)"/>
    <ECEnumerator value="2" name="ACSR" displayLabel="ACSR (Aluminum Conductor Steel Reinforced)"/>
    <ECEnumerator value="3" name="Cu" displayLabel="Cu (Stranded Copper Conductor)"/>
    <ECEnumerator value="4" name="ACSR_AW" displayLabel="ACSR/AW (Aluminum Conductor, Steel Reinforced / Aluminum-Clad Steel Wire)"/>
    <ECEnumerator value="5" name="ACSS" displayLabel="ACSS (Aluminum Conductor, Steel Supported)"/>
    <ECEnumerator value="6" name="ACSS_AW" displayLabel="ACSS/AW (Aluminum Conductor, Steel Supported / Aluminum-Clad Steel Wire)"/>
  </ECEnumeration>
  <ECEnumeration typeName="CableSize" backingTypeName="int" isStrict="false" displayLabel="Cable Size" description="The nominal conductor size of a cable, in AWG or kcmil.">
    <ECEnumerator value="0" name="AWG6" displayLabel="6 AWG"/>
    <ECEnumerator value="1" name="AWG4" displayLabel="4 AWG"/>
    <ECEnumerator value="2" name="AWG2" displayLabel="2 AWG"/>
    <ECEnumerator value="3" name="AWG1_0" displayLabel="1/0 AWG"/>
    <ECEnumerator value="4" name="Kcmil266_8" displayLabel="266.8 kcmil"/>
    <ECEnumerator value="5" name="Kcmil336_4" displayLabel="336.4 kcmil"/>
    <ECEnumerator value="6" name="Kcmil477" displayLabel="477 kcmil"/>
  </ECEnumeration>
  <!-- Information Classes -->
  <ECEntityClass typeName="WorkspaceInformation" displayLabel="Workspace Information" description="An element that holds Workspace information." modifier="None">
    <BaseClass>bis:InformationRecordElement</BaseClass>
  </ECEntityClass>
  <ECEntityClass typeName="RelativeElevation" displayLabel="Relative Elevation" description="An element that holds Relative Elevation information." modifier="None">
    <BaseClass>bis:InformationRecordElement</BaseClass>
    <ECProperty propertyName="ElevationPoint" displayLabel="Elevation Point" typeName="Point3d" description="The point representing Project Elevation Datum."/>    
    <ECProperty propertyName="RevealHeight" displayLabel="Reveal Height" typeName="double" description="The current reveal height, in meters, used when placing foundations with the Fixed Reveal method."/>
  </ECEntityClass>
  <ECEntityClass typeName="BomDocument" displayLabel="BOM Document" description="A single bill of materials document containing application-specific BOM content." modifier="None">
    <BaseClass>bis:Document</BaseClass>
      <ECProperty propertyName="Content" displayLabel="Content" typeName="string" extendedTypeName="Json" description="Application-owned JSON containing a schemaVersion and the content of a single BOM document. The application manages JSON schema versioning, migration of older payloads, and compatibility checks before editing."/>
  </ECEntityClass>
</ECSchema>
