<ECSchema schemaName="DrawingProductionUnits" alias="dpu" version="01.00.00" description="This contains the unit definitions that are used across applications using drawing production" xmlns="http://www.bentley.com/schemas/Bentley.ECXML.3.2">
    <ECSchemaReference name="CoreCustomAttributes" version="01.00.04" alias="CoreCA"/>
    <ECSchemaReference name="BisCustomAttributes" version="01.00.00" alias="bisCA"/>
    <ECSchemaReference name="Formats" version="01.00.00" alias="f"/>
    <ECSchemaReference name="Units" version="01.00.12" alias="u"/>

    <ECCustomAttributes>
        <ProductionStatus xmlns="CoreCustomAttributes.01.00.04">
            <SupportedUse>NotForProduction</SupportedUse>
        </ProductionStatus>
        <SchemaLayerInfo xmlns="BisCustomAttributes.01.00.00">
            <Value>Application</Value>
        </SchemaLayerInfo>
    </ECCustomAttributes>
  
    <KindOfQuantity typeName="TEXT_HEIGHT" displayLabel="Text Height" description="Vertical height measurements for text in drawing production annotations" persistenceUnit="u:M" presentationUnits="f:DefaultRealU(2)[u:MM];f:DefaultRealU(2)[u:IN]" relativeError="0.0001"/>
    <KindOfQuantity typeName="PAPER_DISTANCE" displayLabel="Paper height" description="A distance measured on the sheet rather than in the real world, the default measurement format for anything you place while designing a sheet template, including sheet width and height." persistenceUnit="u:M" presentationUnits="f:DefaultRealU(2)[u:MM];f:DefaultRealU(2)[u:IN]" relativeError="0.0001"/>    
</ECSchema>